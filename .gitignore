# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variables de entorno: NUNCA se suben (contienen claves). La plantilla .env.example sí.
.env*
!.env.example

# Configuración local de las herramientas de Claude (previsualización, permisos)
/.claude/

# PDF original del portafolio (54 MB): se queda solo en el disco local
/Portafolio JD*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Fotos extraídas del portafolio y hojas de contactos de revisión (pesan mucho y el repositorio es público)
/data/imagenes_pdf/
/data/imagenes_pdf_revisar/
/data/revision_imagenes/hojas/

# Listas de precios del proveedor y su emparejamiento (datos internos; el repo es público)
/data/precios_ev/
/data/fotos_maestro/
