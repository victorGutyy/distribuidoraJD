# Copia este archivo a .env.local y pon tus valores reales.
#   cp .env.example .env.local
# .env.local está en .gitignore: NUNCA lo subas a git ni pegues las claves en un chat.
#
# Dónde encontrarlas: Supabase → tu proyecto → Project Settings → API / API Keys.

# URL del proyecto (pública). Ej.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon / publishable). Va al navegador; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (service_role / secret). SECRETA: solo código de servidor.
# Omite RLS. No lleva el prefijo NEXT_PUBLIC_ a propósito.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública del sitio (SEO, mapa del sitio, vista previa al compartir). Ej.: https://www.evdistribuidora.co
# Si queda vacía se usa el dominio de producción de Vercel; en local, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Aviso de pedido nuevo por correo (Resend, https://resend.com). Si faltan, simplemente no se envía. ---
# Clave de API de Resend (SECRETA, solo servidor).
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend. Ej.: EV Distribuidora <pedidos@evdistribuidora.co>
CORREO_REMITENTE=
# Quién recibe el aviso de cada pedido nuevo (uno o varios correos separados por coma).
CORREO_AVISO_PEDIDOS=
